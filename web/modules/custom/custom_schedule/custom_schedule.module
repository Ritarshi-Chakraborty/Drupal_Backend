<?php

/**
 * @file
 * Implementing some hooks.
 */

/**
 * Implements hook_cron().
 */
function custom_schedule_cron() {
  $queue = \Drupal::queue('article_delete_queue');

  // Find article nodes created before 5 days ago.
  $timestamp_5_days_ago = \Drupal::time()->getRequestTime() - 5 * 24 * 60 * 60;

  // Query to get node IDs of articles older than 5 days.
  $nids = \Drupal::entityQuery('node')
    ->condition('type', 'article')
    ->condition('created', $timestamp_5_days_ago, '<')
    ->condition('status', 1)
    ->accessCheck(TRUE)
    ->execute();

  // Add each node ID to the queue.
  foreach ($nids as $nid) {
    $queue->createItem($nid);
  }

  // Process a limited number of items in the queue in this cron run.
  $max_items = 5;
  $count = 0;

  while ($item = $queue->claimItem()) {
    try {
      \Drupal::service('plugin.manager.queue_worker')
        ->createInstance('article_delete_queue')
        ->processItem($item->data);

      $queue->deleteItem($item);
    }
    catch (\Exception $e) {
      \Drupal::logger('custom_schedule')->error($e->getMessage());
      $queue->releaseItem($item);
    }

    $count++;
    if ($count >= $max_items) {
      break;
    }
  }
}





