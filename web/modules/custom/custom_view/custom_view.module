<?php

/**
 * @file
 * This is the module file of this module.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\node\Entity\Node;
use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\QueryPluginBase;

/**
 * Implements hook_node_view().
 */
function custom_view_node_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display) {
  // Displays the clubs of the same league.
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'football_club') {
    if (!$entity->get('field_league')->isEmpty()) {
      $term_id = $entity->get('field_league')->target_id;
      $query = Drupal::entityQuery('node')
        ->condition('type', 'football_club')
        ->condition('status', 1)
        ->condition('field_league', $term_id)
        ->condition('nid', $entity->id(), '!=')
        ->range(0, 5)
        ->sort('created', 'DESC')
        ->accessCheck(TRUE);
      $nids = $query->execute();
      if (!empty($nids)) {
        $nodes = Node::loadMultiple($nids);
        $items = [];
        foreach ($nodes as $node) {
          $items[] = [
            '#type' => 'link',
            '#title' => $node->label(),
            '#url' => $node->toUrl(),
          ];
        }
        $build['related_nodes'] = [
          '#theme' => 'item_list',
          '#title' => t('Other Teams in this League'),
          '#items' => $items,
          '#weight' => 1000,
        ];
      }
    }
  }

  // Displays the players of the club.
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'football_club') {
    $term_id = $entity->id();
    $query = Drupal::entityQuery('node')
      ->condition('type', 'football_player')
      ->condition('field_team', $term_id)
      ->sort('created', 'DESC')
      ->accessCheck(TRUE);

    $nid_list = $query->execute();
    if (!empty($nid_list)) {
      $nodes = Node::loadMultiple($nid_list);
      $items = [];
      foreach ($nodes as $node) {
        $items[] = [
          '#type' => 'markup',
          '#markup' => $node->label(),
        ];
      }
      $build['club_players'] = [
        '#theme' => 'item_list',
        '#title' => t('Players of this club'),
        '#items' => $items,
        '#weight' => 1001,
      ];
    }
  }
}

/**
 * Implements hook_views_query_alter().
 */
function custom_view_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() === 'football' && $view->current_display === 'page_1') {
    // Remove existing logic if you want to completely override.
    $query->orderby = [];
    // Add custom logic.
    $query->addOrderBy('node_field_data', 'title', 'ASC');
    // $query->range(0, 3);
  }
}

/**
 * Implements hook_views_data_alter().
 */
function custom_view_views_data_alter(array &$data) {
  if (isset($data['node__field_team']['field_team_target_id'])) {
    $data['node__field_team']['field_team_target_id']['relationship'] = [
      'title' => t('Club Details'),
      'help' => t('Relate football_player to football_club via field_team.'),
      'id' => 'standard',
      'base' => 'node_field_data',
      'base field' => 'nid',
      'relationship field' => 'field_team_target_id',
      'label' => t('Club'),
    ];
  }
}
