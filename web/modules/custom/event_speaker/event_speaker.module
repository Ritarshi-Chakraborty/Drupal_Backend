use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\node\Entity\Node;
use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\Core\Ajax\AjaxRequest;

/**
 * Implements hook_webform_submission_form_alter().
 */
function event_speaker_webform_submission_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  // Check for a specific webform ID.
  if ($form['#webform_id'] === 'event_registration') {
    // Check if the field exists.
    if (isset($form['elements']['node_url'])) {
      // Disable the field.
      $form['elements']['node_url']['#disabled'] = TRUE;
      // Get the current URL.
      $current_url = \Drupal::request()->getUri();
      // Set the default value.
      $form['elements']['node_url']['#default_value'] = $current_url;
    }
  }
}

/**
 * Implements hook_node_view().
 */
function event_speaker_node_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display) {
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'event') {
    // Get the node id.
    $node_id = $entity->id();
    // Get current formatted date.
    $current_time = \Drupal::time()->getCurrentTime();
    $date_today = \Drupal::service('date.formatter')->format($current_time, 'custom', 'Y-m-d');
    // Get timestamp for tomorrow 00:00 (i.e. exclude today) and format it.
    $start_of_tomorrow = strtotime('tomorrow');
    $date_tomorrow = \Drupal::service('date.formatter')->format($start_of_tomorrow, 'custom', 'Y-m-d');

    // Build the query and execute it.
    $query = Drupal::entityQuery('node')
      ->condition('type', 'event')
      ->condition('nid', $node_id, '!=')
      ->condition('field_start_date', $date_tomorrow, '>=')
      ->sort('field_start_date', 'DESC')
      ->accessCheck(TRUE);
    $nid_list = $query->execute();

    if (!empty($nid_list)) {
      $nodes = Node::loadMultiple($nid_list);
      $items = [];
      foreach ($nodes as $node) {
        $items[] = [
          '#type' => 'link',
          '#title' => $node->label(),
          '#url' => $node->toUrl(),
        ];
      }
      $build['upcoming_events'] = [
        '#theme' => 'item_list',
        '#title' => t('Upcoming Events'),
        '#items' => $items,
        '#weight' => 1000,
      ];
    }
    // Retrieve the date from the datetime.
    $datetime_item = $entity->field_start_date->first();
    $drupalDateTime = new DrupalDateTime($datetime_item->value);
    $formatted_date = $drupalDateTime->format('Y-m-d');
  }
}






