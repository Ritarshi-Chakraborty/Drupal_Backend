<header class="page-header">
  <nav class="navbar">
    <div class="header">{{ page.header }}</div>
    <div>{{ page.primary_menu }}</div>
    <div>{{ page.secondary_menu }}</div>
  </nav>
</header>
<main class="main">
  {% block main %}
  <div class="breadcrumb-container">{{ page.breadcrumbs }}</div>
  <div>{{ page.highlighted }}</div>
  {% block content %}
    <section class="main-content">{{ page.content }}</section>
  {% endblock %}
  {% endblock %}
  <a class="front-page-link" href={{ url('<front>') }}>Front Page</a>
</main>
<footer class="page-footer">{{ page.footer }}</footer>
